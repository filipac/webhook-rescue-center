{
    "name": "interview/webhook-rescue-center",
    "description": "A small Symfony backend exercise for a live senior PHP interview.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4.1",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_sqlite": "*",
        "doctrine/dbal": "^4.3",
        "doctrine/doctrine-bundle": "^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.3",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/validator": "8.1.*",
        "symfony/yaml": "8.1.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.1"
        },
        "sort-packages": true
    },
    "scripts": {
        "setup": [
            "@composer install",
            "@migrate",
            "@test"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php -S localhost:8000 -t public public/index.php"
        ],
        "migrate": "@php bin/console doctrine:migrations:migrate --no-interaction",
        "test": "@php bin/phpunit"
    }
}
